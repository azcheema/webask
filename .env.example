# Copy to .env.local for local development.
# Production values are set in the Vercel project settings.

# Public origin. Used for canonical URLs, sitemap, OG, JSON-LD @id values.
# Production must be the real domain, e.g. https://webask.co.uk
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only: contact-form email (Resend). See lib/env.server.ts. ---

# Resend API key. Get one at https://resend.com → API Keys. NEVER commit the
# real value — set it in Vercel only. Optional: when unset (local/preview) the
# contact Server Action logs and no-ops so the build + success UX stay green.
RESEND_API_KEY=

# Sender for the notification + autoresponder. Must be on the Resend-verified
# domain. Display-name form shows "WebAsk" in the inbox. Keep it DISTINCT from
# CONTACT_NOTIFY_EMAIL — a from==to self-send gets greylisted by inbound spam
# filters (info@ is send-only; replies route to hello@ via Reply-To).
CONTACT_FROM_EMAIL="WebAsk <info@webask.co.uk>"

# Inbox that receives lead notifications — a real, monitored mailbox.
CONTACT_NOTIFY_EMAIL=info@webask.co.uk

# --- Server-only: entity identifiers. NOT rendered anywhere today. ---

# Swedish organisationsnummer and VAT number for the operating entity.
#
# ⚠️ These must NOT be visible on the website (founder instruction, 2026-07-28),
# so they live here rather than in data/site.ts, and MUST NOT be given a
# NEXT_PUBLIC_ prefix — that would ship them to the browser bundle.
#
# Set in .env.local (gitignored) only. Kept plumbed so that if decision gate D3
# concludes a statutory disclosure is required, /legal/company-information can
# read them without a data migration.
COMPANY_ORG_NUMBER=
COMPANY_VAT_NUMBER=
